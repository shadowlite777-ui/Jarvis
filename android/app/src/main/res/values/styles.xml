<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Theme applied to the Android Window while the Flutter engine is initializing -->
    <style name="LaunchTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <!-- Show a splash screen on the background. Optionally set an image using android:windowBackground -->
        <item name="android:windowBackground">@android:color/black</item>
    </style>
    <!-- Theme applied to the Android Window as soon as the Flutter engine has started. -->
    <style name="NormalTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@android:color/black</item>
    </style>
</resources>
